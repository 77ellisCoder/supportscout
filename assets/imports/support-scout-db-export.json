        {
            "band_id": 11,
            "band_name": "Red Temples",
            "slug": "red-temples-band",
            "hometown": "Perth",
            "state_region": "Western Australia",
            "country_code": "AU",
            "member_count": 5,
            "formation_year": 2024,
            "status": "active",
            "short_description": "Red Temples are that friend you haven’t caught up with in ages. Blending rock, soul, blues and reggae into a sound immediately familiar yet all their own, their songs are built from the stories and melodies of the everyday. A collective approach to song writing sees the group journey to the cross-roads of wide-ranging musical influences, dark humour and dubious life choices. The five-piece are revelling in bringing their songs to a wider audience, lighting up the scene with their energetic and spirited live shows. Come to the Temple Door, let yourself in and see what’s on the other side.",
            "internal_notes": null,
