API_PORT=3001
DATABASE_URL=postgres://user:password@localhost:5432/supportscout

# SMTP settings used by the existing SupportScout API
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
PR_FROM_EMAIL=

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_API_HOST/calendar/google/callback

# Generate with:
# openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Native app deep-link after successful OAuth
GOOGLE_CALENDAR_SUCCESS_URL=supportscout://calendar-connected
